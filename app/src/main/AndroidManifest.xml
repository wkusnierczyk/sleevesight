<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The pipeline's lookups and the AI service's calls, through `:net` alone (`:wiring`), and
         only for the sources and the service the user switched on (`checkManifest` allows this
         one and the next, besides androidx.core's own). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Whether the phone is online, so the playing track's unreachable sources are asked again
         once it is back (#192, `ConnectivityManager.registerDefaultNetworkCallback`). A normal
         permission: it reads the connection's state and sends nothing. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- To read an API key's QR code (#268), asked for only when the user taps a scan. Frames are
         decoded on the phone (ZXing) and neither kept nor sent. A phone without a camera can still
         install the app and type its keys. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- CAMERA implies a back camera with autofocus as required features, so Google Play would
         hide the app from phones without one: both are declared not required. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- To be a computer's keyboard for a field (#394), asked for only when the user taps "Type on
         a computer": advertising a service named for the session, and taking the computer's
         connection. Before Android 12, BLUETOOTH and BLUETOOTH_ADMIN do both, granted with the app.
         The text comes sealed with a key from the session's QR code; nothing is sent back but
         Bluetooth's acknowledgements. Not location: the phone does not scan. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- BLUETOOTH and BLUETOOTH_ADMIN imply Bluetooth as a required feature: a phone without it
         can still install the app and type its keys. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- The apps with a launcher icon, and those that offer a media browser service or take media
         buttons (most media apps do, including those with no launcher entry), so *Players* can
         name a player (its label) rather than show its package (#435), show its icon, and hear
         when one is uninstalled (#535): from Android 11 on, another app is hidden without this.
         One that is still hidden is not taken as uninstalled: *Players* hides it and keeps its
         switch. Only the label and icon of a player that reported music are read; the list of
         apps is neither kept nor sent. Not QUERY_ALL_PACKAGES, which Play restricts and the app
         does not need. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <!-- The phone's text-to-speech engines, which Read aloud (#325) speaks an insight with:
             from Android 11 on, `TextToSpeech` cannot bind to an engine this app cannot see. No
             permission. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- No backup and no transfer to another phone: either would take the session history and
         the keys off the phone, which the first-run screen says stay on it. allowBackup="false"
         turns both off before Android 12, so there is no fullBackupContent (which lint's
         DataExtractionRules check asks for, hence its tools:ignore); from 12 on,
         dataExtractionRules does, since allowBackup="false" leaves device transfer on.
         The icon, an adaptive one, is also the splash screen's from Android 12 on; its layers are
         generated by assets/logo/src/make_icon.py. The debug build has its own label and icon
         layers (app/src/debug/res, #614).
         No unencrypted connection on any supported version (#696): Android refuses cleartext by
         default only from 9 on, and minSdk is 26, so usesCleartextTraffic="false" says it for 8
         and 8.1 too. No networkSecurityConfig, which from Android 7 on would take its place;
         checkManifest fails on either. -->
    <application
        android:name=".SleevesightApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sleevesight"
        android:usesCleartextTraffic="false"
        tools:ignore="DataExtractionRules">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Turned on by the user in Settings, Notification access; it gives access to the media
             sessions. Only the system can bind it. On Android 12 (API 31) and later, the filter
             meta-data tells the system not to deliver any notifications to the listener (#739;
             measured on a Samsung phone with Android 17: none delivered, media sessions unaffected). -->
        <service
            android:name=".session.SleevesightListenerService"
            android:exported="true"
            android:label="@string/app_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="" />
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="conversations|alerting|silent|ongoing" />
        </service>

        <!-- Drops an uninstalled player from *Players* (#535). PACKAGE_FULLY_REMOVED is exempt
             from Android 8's limit on manifest receivers of implicit broadcasts, and only the
             system sends it, which reaches a receiver that is not exported. -->
        <receiver
            android:name=".settings.PlayerRemovedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
