<?xml version="1.0" encoding="utf-8"?>
<!-- A genre's panel, above its table (#523): what the genre is, and why this track has it. -->
<resources>
    <!-- The credit under a genre's definition: the first words link the Wikipedia article, the
         licence its terms. -->
    <string name="genre_definition_from">From Wikipedia</string>
    <string name="genre_definition_licence">CC BY-SA 4.0</string>
    <!-- In the definition's place, for a genre that has none (#663): it has no MusicBrainz genre, or
         its genre's Wikidata item has no English article (Wikipedia may still have one by the
         genre's name, which the app does not reach, so it does not say there is none). -->
    <string name="genre_definition_none">No definition from Wikipedia for this genre.</string>
    <!-- In the definition's place while it is looked up (#786), after the small turning record, in the
         panel's quiet note style. -->
    <string name="genre_definition_looking">Looking on Wikipedia…</string>
    <!-- In the definition's place when its lookup failed (#786), in the error colour, with Retry
         (home_retry) at the right of the same line, which asks Wikipedia again. -->
    <string name="genre_definition_failed">Wikipedia could not be reached.</string>
    <!-- The source Retry asks again there, as a screen reader names its action (home_retry_action:
         "Double-tap to ask Wikipedia again"). -->
    <string name="genre_definition_source">Wikipedia</string>
    <!-- The button that writes the reason, and the reason's heading once written. %1$s is the genre,
         as a sentence names it ("jazz", "UK garage"). -->
    <string name="genre_why">Why is this %1$s?</string>
    <string name="genre_why_writing">Writing…</string>
    <string name="genre_why_no_evidence">The sources say nothing that explains it.</string>
    <string name="genre_why_failed">The explanation could not be written: %1$s.</string>
    <!-- Under the disabled button, for a genre only MusicBrainz's tags give (D12, #721): their
         licence keeps them out of every prompt. -->
    <string name="genre_why_withheld">This genre comes only from MusicBrainz tags, which Sleevesight doesn’t send to AI services because of their licence.</string>
    <string name="genre_why_incomplete">The reply stopped early, so this is incomplete, and it was not kept.</string>
</resources>
