<?xml version="1.0" encoding="utf-8"?>
<!-- A genre's panel, above its table (#523): what the genre is, and why this track has it. -->
<resources>
    <!-- The credit under a genre's definition: the first words link the Wikipedia article, the
         licence its terms. -->
    <string name="genre_definition_from">From Wikipedia</string>
    <string name="genre_definition_licence">CC BY-SA 4.0</string>
    <!-- In the definition's place, for a genre that has none (#663): it has no MusicBrainz genre, or
         its genre's Wikidata item has no English article (Wikipedia may still have one by the
         genre's name, which the app does not reach, so it does not say there is none). -->
    <string name="genre_definition_none">No definition from Wikipedia for this genre.</string>
    <!-- In the definition's place while it is looked up (#786), after the small turning record, in the
         panel's quiet note style. -->
    <string name="genre_definition_looking">Looking on Wikipedia…</string>
    <!-- In the definition's place when its lookup failed (#786), in the error colour, with Retry
         (home_retry) at the right of the same line, which asks Wikipedia again. -->
    <string name="genre_definition_failed">Wikipedia could not be reached.</string>
    <!-- The source Retry asks again there, as a screen reader names its action (home_retry_action:
         "Double-tap to ask Wikipedia again"). -->
    <string name="genre_definition_source">Wikipedia</string>
    <!-- The button that writes the reason, and the reason's heading once written. %1$s is the genre,
         as a sentence names it ("jazz", "UK garage"). -->
    <string name="genre_why">Why is this %1$s?</string>
    <string name="genre_why_writing">Writing…</string>
    <!-- In the button's place while the AI service is asked (#762: the AI's genre list for a genre
         only MusicBrainz gives, then the reason; or the reason alone), after the small turning
         record, in the panel's quiet note style. -->
    <string name="genre_why_looking">Looking for an explanation…</string>
    <!-- Under every reason, in italics (#762): %1$s is the model's name ("Claude Haiku 5.5"). -->
    <string name="genre_why_by">by %1$s</string>
    <!-- Under the disabled button when the AI could not explain the genre (#762): the AI's genre list
         does not have it, or the sources' evidence cannot support it. -->
    <string name="genre_why_not_found">AI could not find an explanation.</string>
    <!-- When the AI's genre list cannot run (#762), for a genre only MusicBrainz gives: under the
         disabled button, this line, then genre_why_enable on its own line. -->
    <string name="genre_why_no_ai">No AI service enabled.</string>
    <!-- %1$s is what to switch on, each a link that opens Settings where it is (AI service
         knowledge, under Sources), several joined by genre_why_or. -->
    <string name="genre_why_enable">Enable %1$s.</string>
    <string name="genre_why_or">%1$s or %2$s</string>
    <!-- Under the disabled button with no AI service ready (#762): %1$s is
         home_settings_ai_services_link, a link that opens Settings at AI services. -->
    <string name="genre_why_no_service">Enable an AI service in %1$s.</string>
    <!-- In the error colour, with Retry at the right of the same line, which asks again, a paid call:
         %1$s is why the call failed, as the insight words it. -->
    <string name="genre_why_failed">The explanation could not be written: %1$s.</string>
    <string name="genre_why_incomplete">The reply stopped early, so this is incomplete, and it was not kept.</string>
    <!-- How a screen reader reads a genre the AI's genre list added (#762), as a chip and in the
         Track row of Genre tags, where it shows marked AI: %1$s is the genre, %2$s the model's name
         ("Blues, from Claude Haiku 5.5"). -->
    <string name="genre_ai_added">%1$s, from %2$s</string>
</resources>
