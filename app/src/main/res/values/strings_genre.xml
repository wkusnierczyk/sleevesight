<?xml version="1.0" encoding="utf-8"?>
<!-- A genre's panel, above its table (#523): what the genre is, and why this track has it. -->
<resources>
    <!-- The credit under a genre's definition: the first words link the Wikipedia article, the
         licence its terms. -->
    <string name="genre_definition_from">From Wikipedia</string>
    <string name="genre_definition_licence">CC BY-SA 4.0</string>
    <!-- In the definition's place, for a genre that has none (#663): it has no MusicBrainz genre, or
         its genre's Wikidata item has no English article (Wikipedia may still have one by the
         genre's name, which the app does not reach, so it does not say there is none). -->
    <string name="genre_definition_none">No definition from Wikipedia for this genre.</string>
    <!-- In the definition's place while it is looked up (#786), after the small turning record, in the
         panel's quiet note style. -->
    <string name="genre_definition_looking">Looking on Wikipedia…</string>
    <!-- In the definition's place when its lookup failed (#786), in the error colour, with Retry
         (home_retry) at the right of the same line, which asks Wikipedia again. -->
    <string name="genre_definition_failed">Wikipedia could not be reached.</string>
    <!-- The source Retry asks again there, as a screen reader names its action (home_retry_action:
         "Double-tap to ask Wikipedia again"). -->
    <string name="genre_definition_source">Wikipedia</string>
    <!-- The button that writes the reason, and the reason's heading once written. %1$s is the genre,
         as a sentence names it ("jazz", "UK garage"). -->
    <string name="genre_why">Why is this %1$s?</string>
    <string name="genre_why_writing">Writing…</string>
    <!-- In the button's place while the AI service is asked (#762: the AI's genre list for a genre
         only MusicBrainz gives, then the reason; or the reason alone), after the small turning
         record, in the panel's quiet note style. -->
    <string name="genre_why_looking">Looking for an explanation…</string>
    <!-- Under every reason, in italics (#762): %1$s is the model's name ("Claude Haiku 5.5"). -->
    <string name="genre_why_by">by %1$s</string>
    <!-- In its place under a reason from web pages (#695): asked again with web search, and citing a
         page or a source. %1$s is the model's name. -->
    <string name="genre_why_by_web">by %1$s, with web search</string>
    <!-- Under the question, above a reason none of whose sentences cites a source or a web page, only
         the model's own knowledge (#695), in the panel's quiet note style. -->
    <string name="genre_why_from_model">The sources don’t explain this genre. This is from the AI model’s own knowledge, not verified.</string>
    <!-- Under the disabled button when the AI could not explain the genre (#762): the AI's genre list
         does not have it, or nothing the reason was asked with explains it; then, for the reason,
         genre_why_enable on its own line, naming what was off (#695: AI service knowledge, AI web
         search), none with both on. -->
    <string name="genre_why_not_found">AI could not find an explanation.</string>
    <!-- When the AI's genre list cannot run (#762), for a genre only MusicBrainz gives: under the
         disabled button, this line, then genre_why_enable on its own line. -->
    <string name="genre_why_no_ai">No AI service enabled.</string>
    <!-- %1$s is what to switch on, each a link that opens Settings where it is (AI service
         knowledge, under Sources; AI web search, under Insights), several joined by genre_why_or. -->
    <string name="genre_why_enable">Enable %1$s.</string>
    <string name="genre_why_or">%1$s or %2$s</string>
    <!-- Under the disabled button with no AI service ready (#762): %1$s is
         home_settings_ai_services_link, a link that opens Settings at AI services. -->
    <string name="genre_why_no_service">Enable an AI service in %1$s.</string>
    <!-- In the error colour, with Retry at the right of the same line, which asks again, a paid call:
         %1$s is why the call failed, as the insight words it. -->
    <string name="genre_why_failed">The explanation could not be written: %1$s.</string>
    <string name="genre_why_incomplete">The reply stopped early, so this is incomplete, and it was not kept.</string>
    <!-- How a screen reader reads a genre the AI's genre list added (#762), as a chip and in the
         Track row of Genre tags, where it shows marked AI: %1$s is the genre, %2$s the model's name
         ("Blues, from Claude Haiku 5.5"). -->
    <string name="genre_ai_added">%1$s, from %2$s</string>
    <!-- How a screen reader reads a genre chip whose evidence is weak (#875), shown dimmed and in
         italics: a track's tag no artist's or album's tags include, with few MusicBrainz votes or
         from Last.fm alone. %1$s is the genre ("Country, weak evidence"). -->
    <string name="genre_weak">%1$s, weak evidence</string>
    <!-- Under a weak genre's definition (#875), before Why is this …?, in the panel's quiet note
         style: why its evidence is weak. %1$s is the genre, in italics, as its chip names it; %2$s
         is one of the genre_weak_* clauses below, or nothing when the track has no other level of
         tags. When MusicBrainz contributors tagged the track with it: -->
    <string name="genre_weak_musicbrainz">Few MusicBrainz contributors tagged this track %1$s%2$s.</string>
    <!-- When only Last.fm's tags for the track give it. -->
    <string name="genre_weak_lastfm">Only Last.fm’s tags for this track give %1$s%2$s.</string>
    <!-- The clause, after the genre, when the artist's tags are there (one artist, or several) and
         the album's are not; the album's and not the artist's; both. -->
    <string name="genre_weak_artist">, and the artist’s tags don’t include it</string>
    <string name="genre_weak_artists">, and the artists’ tags don’t include it</string>
    <string name="genre_weak_album">, and the album’s tags don’t include it</string>
    <string name="genre_weak_both">, and neither the artist’s nor the album’s tags include it</string>
    <string name="genre_weak_both_artists">, and neither the artists’ nor the album’s tags include it</string>
    <!-- Under Instrumental's definition when it is weak for a sign that the track is sung (#996),
         in the same note style as genre_weak_musicbrainz; the genre, in italics, as its chip names
         it. When MusicBrainz gives the song's work a language: %1$s is the language ("Japanese"),
         %2$s the genre. -->
    <string name="genre_weak_language">MusicBrainz lists this song’s lyrics as %1$s, so it is likely not %2$s.</string>
    <!-- The same, for a language Sleevesight has no name for (or several languages): %1$s is the
         genre. -->
    <string name="genre_weak_lyrics">MusicBrainz lists lyrics for this song, so it is likely not %1$s.</string>
    <!-- When MusicBrainz credits someone with vocals on the recording: %1$s is their name as
         MusicBrainz gives it, %2$s the genre. -->
    <string name="genre_weak_vocalist">MusicBrainz credits %1$s with vocals on this track, most likely it is not %2$s.</string>
    <!-- When MusicBrainz credits someone with the words of the song's work (a lyricist, #998): %1$s is
         their name as MusicBrainz gives it, %2$s the genre. -->
    <string name="genre_weak_lyricist">MusicBrainz credits %1$s with the lyrics of this song, so it is likely not %2$s.</string>
    <!-- When the track credits several artists and one of them has no artist's tag of the genre
         while another artist's or the album's tags give it: %1$s is that artist, as the track
         credits them. It does not name the genre. -->
    <string name="genre_weak_featured">This track also credits %1$s and may feature vocals.</string>
    <!-- How a screen reader reads a genre the artist's description names (#1000), as a chip and in
         its Described row of Genre tags: %1$s is the genre ("Instrumental, from the artist’s
         description"). -->
    <string name="genre_described">%1$s, from the artist’s description</string>
    <!-- Under the definition of a genre the artist's description names (#1000), before Why is this
         …?, in the panel's quiet note style, the citation of the line after it: %1$s is the line's
         sentence that names the genre, cut to the words around it, "…" where cut. -->
    <string name="genre_described_named">Named in the artist’s description: “%1$s”</string>
    <!-- In its place for Instrumental only the artist's description gives (#1000, #998's artist
         hint), shown as a weak genre: %1$s is the line's sentence, as above. -->
    <string name="genre_weak_hint">The artist’s description calls them instrumental, but no source says so of this track: “%1$s”</string>
    <!-- Under Instrumental's definition while the check of the track's vocals runs (#998), after the
         small turning record, in the panel's quiet note style. -->
    <string name="genre_vocals_checking">Checking whether this track has vocals…</string>
    <!-- Under Instrumental's definition once the check of the track's vocals (#998) found a page that
         describes it as instrumental, the page's citation after it; then genre_why_by_web. -->
    <string name="genre_vocals_instrumental">Web search found this track described as instrumental.</string>
    <!-- The same once it found vocals, after a tap on Why is this instrumental?: the chip stays weak
         until the genres are built again. %1$s is the genre, in italics, as its chip names it. -->
    <string name="genre_vocals_found">Web search found vocals on this track, so it is not %1$s.</string>
    <!-- The same once no page said either, after a tap. -->
    <string name="genre_vocals_unknown">Web search found nothing on whether this track has vocals.</string>
</resources>
