#!/usr/bin/env bash
# The merge check: refuses a merge commit whose result leaves out lines that the incoming side added,
# unless the commit message says why. Run by `pre-commit`, `pre-merge-commit` and `commit-msg`; not a
# hook itself. A merge resolution can drop the other side's text without a word (a bullet and a
# sentence in `design/design.md`, lost in two merges on one branch), and nothing else looks for it.
#
# The rule, for each incoming commit (`MERGE_HEAD`) against the current one (`HEAD`), from their merge
# base: every line the incoming side added must be in the merged result (the index), compared without
# leading and trailing whitespace, unless
#   - the line is blank or whitespace only;
#   - the current side changed the same lines of the base, or lines next to them (the two edits meet,
#     so git made it a conflict, and keeping one side there is the resolution, not a loss);
#   - the current side deleted the file; or
#   - the merge commit's message has a trailer `Dropped: <path>: <why>` for the file, which carries
#     the choice into the pull request's commits and their reviews. The path is exact, in one of three
#     forms: plain (`Dropped: f.txt: why`, no colon in the path, a space after the colon), in
#     backticks (`Dropped: `f.txt`: why`), or quoted as git quotes paths (`Dropped: "a:b\n.txt": why`,
#     with `\"`, `\\`, `\t`, `\n` and octal escapes such as `\303`), the only form for a path with a
#     colon, a newline or another control character. A refusal prints the trailer for each file.
# The incoming side's renames are followed, and the current side's too, so a renamed file is
# compared with what it became in the result: under either side's new name (both renamed it), or,
# by rename detection from the incoming commit to the result, under a name the resolution gave it.
# Binary files, symbolic links and submodules are not checked, nor is a file that is a submodule on
# either side or in the result (a file turned into a submodule, or back).
#
# When: the decision is taken in `commit-msg`, the only hook that sees both the merge and its message.
# git runs it for a merge concluded with `git commit` (after conflicts) and for one `git merge`
# records itself (no conflicts), in both cases with `MERGE_HEAD` and the merged index in place.
# `pre-merge-commit` runs before git writes `MERGE_HEAD`, so it cannot check anything. If the clone
# has no `commit-msg` hook from `.githooks/install` (installed before the merge check existed),
# `pre-commit` makes the check instead, without trailers, and `pre-merge-commit` says to install it.
#
# Usage:
#   merge-check pre-commit | pre-merge-commit | commit-msg <message file>   (from the hooks)
#   merge-check replay <merge commit>...   checks recorded merges (their first parent against each
#                                          other parent, their tree, their message); exit 1 if any fails
set -euo pipefail
export LC_ALL=C GIT_LITERAL_PATHSPECS=1
# Settings that would change a diff's hunks (its context, `-u5`) or call another program for it.
unset GIT_DIFF_OPTS GIT_EXTERNAL_DIFF

marker='# sleevesight hook dispatcher'
trailer_key=Dropped

# Nothing that can fail runs before the check knows that a merge is being committed: a commit that is
# not a merge must never be held up by the check's own trouble (no scratch space, a git error). Once
# it is checking a merge, such trouble refuses the merge, saying so: a merge not checked is not passed.
# The analysis does not rely on `set -e` for this (it is off in a function called in a condition):
# every command its decision depends on has its status checked, and a failure calls `die`.
work=
tab=$'\t' bs=\\
finished=0
# shellcheck disable=SC2329 # run by the trap below
on_exit() {
  local status=$?
  [ -z "$work" ] || rm -rf "$work"
  if [ "$finished" -eq 0 ] && [ "$status" -ne 0 ]; then
    printf >&2 'merge-check: the check itself failed (exit %s, see above), so the merge was not checked.\n' "$status"
  fi
}
trap on_exit EXIT

# finish <status>: exits with it, as the check's own decision.
finish() {
  finished=1
  exit "$1"
}

# die <what failed>: the check's own failure. It exits at once, from any depth (never call it in a
# subshell), and `on_exit` says that the merge was not checked.
die() {
  printf >&2 'merge-check: %s\n' "$*"
  exit 3
}

# merging: whether a merge is being committed in this checkout (`MERGE_HEAD` is there). Any error
# reads as no. (`--git-path` is relative to the current directory, the top level in a hook.)
merging() {
  local f
  f=$(git rev-parse --git-path MERGE_HEAD 2>/dev/null) && [ -n "$f" ] && [ -f "$f" ]
}

# scratch: the check's scratch directory, into $work.
scratch() {
  work=$(mktemp -d)
}

# Whether git will run this checkout's `commit-msg`, and so the check with its trailers.
commit_msg_installed() {
  local hook
  hook=$(git rev-parse --git-path hooks 2>/dev/null)/commit-msg || return 1
  [ -x "$hook" ] && grep -qE "^$marker\$|merge-check" "$hook"
}

# The commit message without its comments and anything below the scissors line of `commit -v`.
clean_message() {
  local c st=0
  c=$(git config --get core.commentChar) || st=$?
  case "$st" in 0) ;; 1) c= ;; *) die "git config failed (exit $st)" ;; esac
  case "$c" in '' | auto) c='#' ;; esac
  MC_COMMENT=$c awk '
    BEGIN { c = ENVIRON["MC_COMMENT"] }
    $0 == c " ------------------------ >8 ------------------------" { exit }
    index($0, c) != 1 { print }
  ' "$1"
}

# needs_quote <path>: whether a trailer can name <path> only in the quoted form: it has a colon, a
# quote, a backslash, a backtick or a control character (a tab, a newline), or starts with a space.
needs_quote() {
  case "$1" in *[:\"\\\`]* | *[[:cntrl:]]* | ' '*) return 0 ;; esac
  return 1
}

# trailer_path <path>: <path> as a trailer names it: plain, or quoted where it needs to be, as git
# quotes paths (bytes above 127 are left as they are, which the reading accepts too).
trailer_path() {
  local s=$1 out='"' ch code i
  needs_quote "$s" || { printf '%s' "$s"; return 0; }
  for ((i = 0; i < ${#s}; i++)); do
    ch=${s:i:1}
    case "$ch" in
      '"') out+='\"' ;;
      "$bs") out+=$bs$bs ;;
      $'\a') out+='\a' ;; $'\b') out+='\b' ;; $'\t') out+='\t' ;; $'\n') out+='\n' ;;
      $'\v') out+='\v' ;; $'\f') out+='\f' ;; $'\r') out+='\r' ;;
      [[:cntrl:]]) printf -v code '\\%03o' "'$ch"; out+=$code ;;
      *) out+=$ch ;;
    esac
  done
  printf '%s"' "$out"
}

# unquote <value>: reads a quoted path at the start of <value> into `uq_path`, and what follows the
# closing quote into `uq_rest`; fails if it is not a well-formed quoted path.
unquote() {
  local s=$1 i=1 n=${#1} ch out='' oct
  [ "${s:0:1}" = '"' ] || return 1
  while [ "$i" -lt "$n" ]; do
    ch=${s:i:1}
    i=$((i + 1))
    case "$ch" in
      '"') uq_path=$out uq_rest=${s:i}; return 0 ;;
      "$bs")
        ch=${s:i:1}
        i=$((i + 1))
        case "$ch" in
          '"' | "$bs") out+=$ch ;;
          a) out+=$'\a' ;; b) out+=$'\b' ;; t) out+=$'\t' ;; n) out+=$'\n' ;;
          v) out+=$'\v' ;; f) out+=$'\f' ;; r) out+=$'\r' ;;
          [0-3])
            oct=$ch${s:i:2}
            i=$((i + 2))
            case "$oct" in 000) return 1 ;; [0-3][0-7][0-7]) ;; *) return 1 ;; esac
            printf -v ch '%b' "${bs}0$oct"
            out+=$ch ;;
          *) return 1 ;;
        esac ;;
      *) out+=$ch ;;
    esac
  done
  return 1
}

# excused <path>: whether the message (in $work/trailers, one value per line) excuses drops in <path>:
# a value that names exactly that path, in one of the forms at the top, then `:` and a reason
# (something other than spaces and punctuation).
excused() {
  local v p rest
  [ -s "$work/trailers" ] || return 1
  while IFS= read -r v || [ -n "$v" ]; do
    case "$v" in
      '"'*)
        unquote "$v" || continue
        p=$uq_path rest=$uq_rest ;;
      '`'*)
        p=${v#\`}
        case "$p" in *'`'*) ;; *) continue ;; esac
        rest=${p#*\`} p=${p%%\`*} ;;
      *)
        # The path runs to the first colon, which a space follows: `f.txt:old: why` names nothing.
        p=${v%%:*} rest=${v#*:}
        [ "$p" != "$v" ] || continue
        case "$rest" in [[:space:]]*) rest=:$rest ;; *) continue ;; esac ;;
    esac
    case "$rest" in :*) ;; *) continue ;; esac
    [ "$p" = "$1" ] || continue
    case "$rest" in *[![:space:][:punct:]]*) return 0 ;; esac
  done <"$work/trailers"
  return 1
}

# Every `git diff` here, with each option a user's configuration could change pinned to git's default
# (or to what `git merge` uses), so the hunks and paths are the same in every clone: no external diff
# or text conversion, no colour, the whole tree from any directory (`diff.relative`), hunks not joined
# across unchanged lines (`diff.interHunkContext`), one algorithm (`diff.algorithm`), no sliding of
# hunks (`diff.indentHeuristic`), rename detection as the merge sees it (`diff.renameLimit`).
diff_opts=(--no-ext-diff --no-textconv --no-color --no-relative --inter-hunk-context=0
  --diff-algorithm=myers --no-indent-heuristic --src-prefix=a/ --dst-prefix=b/ -l7000)
gdiff() { git diff "${diff_opts[@]}" "$@"; }

# blob_diff <blob> <blob> <file>: the `-U0` diff between two blobs (for binary blobs, no hunks).
# added_file <blob> <file>: the same for a file the base does not have, all of it added (an insertion
# before line 1), and no hunks if it is binary, by git's own test: a NUL byte in its first 8000 bytes.
blob_diff() { gdiff -U0 "$1" "$2" >"$3" || die "git diff failed (exit $?)"; }
added_file() {
  local nuls
  git cat-file blob "$1" >"$work/added" || die "git cat-file failed for $1"
  nuls=$(head -c 8000 "$work/added" | tr -dc '\0' | wc -c) || die 'could not read an added file'
  if [ "$nuls" -ne 0 ]; then : >"$2"; return 0; fi
  { printf '@@ -0,0 +1 @@\n' && sed 's/^/+/' "$work/added"; } >"$2" || die 'could not read an added file'
}

# is_file <mode>: whether an entry of that mode is a file (not a link, a submodule or a directory).
is_file() { case "$1" in 100644 | 100755) return 0 ;; esac; return 1; }

# entry_at <tree> <path>: the entry at <path> in <tree>, into `e_mode` and `e_oid`, both empty if there
# is none. file_at <tree> <path>: the same, and whether it is a file.
entry_at() {
  local rec
  e_mode='' e_oid=''
  git ls-tree -z --full-tree "$1" -- "$2" >"$work/entry" || die "git ls-tree failed (exit $?)"
  while IFS= read -r -d '' rec; do
    [ "${rec#*"$tab"}" = "$2" ] || continue
    rec=${rec%%"$tab"*}   # "<mode> <type> <object>"
    e_mode=${rec%% *} e_oid=${rec##* }
  done <"$work/entry"
}
file_at() { entry_at "$1" "$2" && is_file "$e_mode"; }

# dropped <ours hunks> <ours deleted the file: 0|1> <result content> <theirs diff>: the incoming side's
# added lines that the result lacks, outside the current side's hunks, as `<line number>\t<line>`.
dropped() {
  MC_OURS=$1 MC_OURS_ALL=$2 MC_RESULT=$3 MC_THEIRS=$4 awk '
    BEGIN { ours = ENVIRON["MC_OURS"]; ours_all = ENVIRON["MC_OURS_ALL"] + 0
            result = ENVIRON["MC_RESULT"]; theirs = ENVIRON["MC_THEIRS"] }
    function trim(s) { sub(/^[ \t\r\f\v]+/, "", s); sub(/[ \t\r\f\v]+$/, "", s); return s }
    # The base lines a hunk replaces, as an interval where base line k is 2k and the gap after it
    # 2k+1, widened to the gaps on either side: hunks that touch or meet overlap.
    function span(h,   f, x, n, a, b) {
      split(h, f, " ")
      n = split(substr(f[2], 2), x, ","); a = x[1] + 0; b = (n > 1) ? x[2] + 0 : 1
      if (b > 0) { lo = 2 * a - 1; hi = 2 * (a + b - 1) + 1 } else { lo = 2 * a + 1; hi = lo }
      n = split(substr(f[3], 2), x, ","); start = x[1] + 0
    }
    FILENAME == ours { if (/^@@ /) { span($0); k++; olo[k] = lo; ohi[k] = hi }; next }
    FILENAME == result { have[trim($0)] = 1; next }
    FILENAME == theirs {
      if (/^@@ /) {
        span($0); inhunk = 1; line = start; exempt = (ours_all == 1)
        for (i = 1; i <= k && !exempt; i++) if (olo[i] <= hi && lo <= ohi[i]) exempt = 1
        next
      }
      if (!inhunk || substr($0, 1, 1) != "+") next
      s = substr($0, 2); t = trim(s)
      if (t != "" && !exempt && !(t in have)) print line "\t" s
      line++
    }
  ' "$1" "$3" "$4"
}

# raw <from> <to>: `git diff --raw -z -M` between two commits, into the arrays `r_st` (status letter),
# `r_old` and `r_new` (paths), `r_oblob`, `r_nblob`, `r_omode` and `r_mode` (the old and new modes). The paths are read
# NUL-delimited as git writes them and stay in variables from there on, so every byte but NUL
# survives (tabs, newlines, backslashes); they are never put in a line-based file or an `awk -v`.
raw() {
  local meta p1 p2 omode nmode oblob nblob st i=0
  r_st=() r_old=() r_new=() r_oblob=() r_nblob=() r_omode=() r_mode=()
  # Into a file first, so that a git error stops the check rather than passing it.
  gdiff --raw -z -M --no-abbrev "$1" "$2" >"$work/raw" || die "git diff failed (exit $?)"
  while IFS= read -r -d '' meta; do
    IFS= read -r -d '' p1
    p2=$p1
    # meta: ":<old mode> <new mode> <old blob> <new blob> <status>"
    read -r omode nmode oblob nblob st <<<"${meta#:}"
    case "$st" in R* | C*) IFS= read -r -d '' p2 ;; esac
    r_st[i]=${st:0:1} r_old[i]=$p1 r_new[i]=$p2 r_oblob[i]=$oblob r_nblob[i]=$nblob
    r_omode[i]=$omode r_mode[i]=$nmode
    i=$((i + 1))
  done <"$work/raw"
}

# read_trailers <message file>: the values of its `Dropped:` trailers, one per line, into
# $work/trailers. git reads them with no configuration at all, outside the repository and without the
# user's and the system's settings: `trailer.separators` would change what is a trailer, and a
# `trailer.<name>.key` would rename one. (Comments are gone already, by `clean_message`.)
read_trailers() {
  clean_message "$1" >"$work/message.clean"
  (
    cd "$work" || exit 1
    unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
    HOME=$work XDG_CONFIG_HOME=$work GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
      GIT_CEILING_DIRECTORIES=$(dirname "$work") git -c trailer.separators=: interpret-trailers --parse
  ) <"$work/message.clean" >"$work/message.trailers" || die "git interpret-trailers failed (exit $?)"
  awk -v k="$trailer_key" 'tolower(substr($0, 1, length(k) + 1)) == tolower(k) ":" {
    v = substr($0, length(k) + 2); sub(/^[ \t]+/, "", v); print v }' "$work/message.trailers" >"$work/trailers" ||
    die 'could not read the trailers'
}

# check <ours> <theirs> <result tree>: reports what the result drops of what <theirs> added, and fails
# if any of it is not excused. (Only the wording of a refusal, the commits named and their subjects,
# is left to commands whose failure is not checked.)
check() {
  local ours=$1 theirs=$2 tree=$3 base st=0 short i j status old new oblob nblob
  local ostatus onew oblob2 omode2 path shown ours_all report=$work/report refused=0
  local o_st o_old o_new o_nblob o_mode t_st t_old t_new t_oblob t_nblob t_omode t_mode m_st m_old m_new
  local moves_read=0
  base=$(git merge-base "$ours" "$theirs") || st=$?
  case "$st" in 0) ;; 1) return 0 ;; *) die "git merge-base failed (exit $st)" ;; esac   # 1: unrelated
  short=$(git rev-parse --short "$theirs") || die "git rev-parse failed for $theirs"
  raw "$base" "$ours"
  o_st=(${r_st[@]+"${r_st[@]}"}) o_old=(${r_old[@]+"${r_old[@]}"})
  o_new=(${r_new[@]+"${r_new[@]}"}) o_nblob=(${r_nblob[@]+"${r_nblob[@]}"}) o_mode=(${r_mode[@]+"${r_mode[@]}"})
  raw "$base" "$theirs"
  t_st=(${r_st[@]+"${r_st[@]}"}) t_old=(${r_old[@]+"${r_old[@]}"}) t_new=(${r_new[@]+"${r_new[@]}"})
  t_oblob=(${r_oblob[@]+"${r_oblob[@]}"}) t_nblob=(${r_nblob[@]+"${r_nblob[@]}"})
  t_omode=(${r_omode[@]+"${r_omode[@]}"}) t_mode=(${r_mode[@]+"${r_mode[@]}"})
  : >"$report"
  for ((i = 0; i < ${#t_st[@]}; i++)); do
    status=${t_st[i]} old=${t_old[i]} new=${t_new[i]} oblob=${t_oblob[i]} nblob=${t_nblob[i]}
    case "$status" in A | M | R | T) ;; *) continue ;; esac
    # Text only: not a link or a submodule, before or after (binary files have no hunks, below).
    is_file "${t_mode[i]}" || continue
    [ "$status" = A ] || is_file "${t_omode[i]}" || continue
    # Only where the result is not the incoming side's file can something be missing.
    entry_at "$tree" "$new"
    [ "$e_oid" != "$nblob" ] || continue

    # The current side's change to the same base file (for an added file, its own addition of the
    # same path), and where the file is in the result.
    ostatus='' onew='' oblob2='' omode2=''
    for ((j = 0; j < ${#o_st[@]}; j++)); do
      if [ "$status" = A ]; then
        [ "${o_st[j]}" = A ] && [ "${o_new[j]}" = "$new" ] || continue
      else
        [ "${o_st[j]}" != A ] && [ "${o_old[j]}" = "$old" ] || continue
      fi
      ostatus=${o_st[j]} onew=${o_new[j]} oblob2=${o_nblob[j]} omode2=${o_mode[j]}
      break
    done
    ours_all=0
    path=$new
    : >"$work/ours.diff"
    case "$ostatus" in
      A) printf '@@ -0,0 +1 @@\n' >"$work/ours.diff" ;;
      D) ours_all=1 ;;
      M | T | R)
        # The current side made it a link or a submodule: not text any more.
        is_file "$omode2" || continue
        blob_diff "$oblob" "$oblob2" "$work/ours.diff"
        # A file only the current side renamed is in the result under its new name.
        if [ "$ostatus" = R ] && [ "$status" != R ]; then path=$onew; fi ;;
    esac
    # Not there as a file: the resolution kept another name. Both sides renamed the file (kept under
    # the current side's name), the current side renamed it and the resolution kept the old name, or
    # the resolution moved it itself (found by rename detection from the incoming commit to the
    # result), into a directory of the same name too. A submodule there is not text: not checked.
    if ! file_at "$tree" "$path"; then
      [ "$e_mode" != 160000 ] || continue
      if [ "$ostatus" = R ] && file_at "$tree" "$onew"; then
        path=$onew
      elif file_at "$tree" "$new"; then
        path=$new
      else
        if [ "$moves_read" -eq 0 ]; then
          raw "$theirs" "$tree"
          m_st=(${r_st[@]+"${r_st[@]}"}) m_old=(${r_old[@]+"${r_old[@]}"}) m_new=(${r_new[@]+"${r_new[@]}"})
          moves_read=1
        fi
        for ((j = 0; j < ${#m_st[@]}; j++)); do
          if [ "${m_st[j]}" = R ] && [ "${m_old[j]}" = "$new" ]; then
            path=${m_new[j]}
            break
          fi
        done
        file_at "$tree" "$path" || [ "$e_mode" != 160000 ] || continue
      fi
    fi
    # Here `e_mode` and `e_oid` are the entry at `path`.
    if is_file "$e_mode"; then
      git cat-file blob "$e_oid" >"$work/result" || die "git cat-file failed for $e_oid"
    else
      : >"$work/result"
    fi

    if [ "$status" = A ]; then
      added_file "$nblob" "$work/theirs.diff"
    else
      blob_diff "$oblob" "$nblob" "$work/theirs.diff"
    fi
    dropped "$work/ours.diff" "$ours_all" "$work/result" "$work/theirs.diff" >"$work/dropped" ||
      die 'could not compare the lines'
    [ -s "$work/dropped" ] || continue

    shown=$(trailer_path "$path")
    if excused "$path" || { [ "$path" != "$new" ] && excused "$new"; }; then
      printf 'merge-check: %s: %s line(s) of %s left out, as its Dropped: trailer says.\n' \
        "$shown" "$(wc -l <"$work/dropped" | tr -d ' ')" "$short" >&2
      continue
    fi
    refused=1
    {
      printf '\n%s' "$shown"
      is_file "$e_mode" || printf ' (not in the result)'
      printf '\n'
      # The incoming commit that added each line, by blame on the incoming side.
      local args=() n prev=
      while IFS=$'\t' read -r n _; do args+=(-L "$n,$n"); done <"$work/dropped"
      git blame -l -s "${args[@]}" "$theirs" -- "$new" 2>/dev/null | awk '{ sub(/^\^/, ""); print $1 }' >"$work/blame" ||
        : >"$work/blame"
      paste "$work/blame" "$work/dropped" | while IFS=$'\t' read -r sha n line; do
        if [ "$sha" != "$prev" ]; then
          if [ -n "$sha" ]; then
            printf '  %s\n' "$(git log -1 --format='%h %s' "$sha" 2>/dev/null || echo "$sha")"
          else
            printf '  (commit not found)\n'
          fi
          prev=$sha
        fi
        [ "${#line}" -le 160 ] || line="${line:0:160}..."
        printf '    %s: %s\n' "$n" "$line"
      done
      printf '  To leave them out: %s: %s: <why>\n' "$trailer_key" "$shown"
    } >>"$report"
  done

  if [ "$refused" -eq 1 ]; then
    printf '\nmerge-check: the merge leaves out lines that the incoming side added, where the current side\n' >&2
    printf '(%s) did not change the text around them. Incoming: %s\n' \
      "$(git rev-parse --short "$ours")" "$(git log -1 --format='%h %s' "$theirs")" >&2
    printf 'Each line is shown under the commit that added it, with its line number there.\n' >&2
    cat "$report" >&2
  fi
  return "$refused"
}

# check_merge <message file or ""> <use trailers: 0|1>: the merge being committed in this checkout.
check_merge() {
  local msg=$1 tree theirs failed=0 merge_head
  merge_head=$(git rev-parse --git-path MERGE_HEAD) || die 'git rev-parse failed'
  [ -f "$merge_head" ] || die "no $merge_head"
  : >"$work/trailers"
  [ -z "$msg" ] || read_trailers "$msg"
  tree=$(git write-tree) || die "git write-tree failed (exit $?)"
  while read -r theirs; do
    [ -n "$theirs" ] || continue
    check HEAD "$theirs" "$tree" || failed=1
  done <"$merge_head"
  if [ "$failed" -eq 1 ]; then
    if [ "$2" -eq 1 ]; then
      printf '\nPut them back, or, if leaving them out is meant, say why in the merge commit'"'"'s message with a\n' >&2
      printf 'trailer for each file, as shown above, in the last paragraph with any other trailers, and\n' >&2
      printf 'commit again. A path with a colon, a newline or a quote goes in quotes, as shown.\n\n' >&2
    else
      printf '\nPut them back and commit again. To leave them out on purpose, with a %s: trailer in the\n' "$trailer_key" >&2
      printf 'message saying why, install the commit-msg hook first, which reads it: .githooks/install\n\n' >&2
    fi
  fi
  return "$failed"
}

case "${1:-}" in
  pre-commit)
    merging || finish 0
    # With the commit-msg hook in place the check waits for the message, there.
    if commit_msg_installed; then finish 0; fi
    scratch
    check_merge "" 0 || finish 1
    finish 0 ;;
  pre-merge-commit)
    # No MERGE_HEAD yet: nothing to check here (see the top).
    if ! commit_msg_installed; then
      printf >&2 'merge-check: no commit-msg hook, so this merge is not checked for lines it leaves out.\n'
      printf >&2 'Run .githooks/install to add it.\n'
    fi
    finish 0 ;;
  commit-msg)
    merging || finish 0
    scratch
    check_merge "$2" 1 || finish 1
    finish 0 ;;
  replay)
    shift
    scratch
    failed=0
    for merge in "$@"; do
      commit=$(git rev-parse --verify "$merge^{commit}") || die "not a commit: $merge"
      short=$(git rev-parse --short "$commit") || die "git rev-parse failed for $commit"
      git log -1 --format=%B "$commit" >"$work/message" || die "git log failed for $commit"
      read_trailers "$work/message"
      tree=$(git rev-parse "$commit^{tree}") || die "git rev-parse failed for $commit"
      parents=$(git rev-parse "$commit^@") || die "git rev-parse failed for $commit"
      bad=0
      for theirs in $(printf '%s\n' "$parents" | tail -n +2); do
        check "$commit^1" "$theirs" "$tree" || bad=1
      done
      if [ "$bad" -eq 1 ]; then
        printf 'merge-check: %s refused\n\n' "$short" >&2
        failed=1
      else
        printf 'merge-check: %s ok\n' "$short" >&2
      fi
    done
    finish "$failed" ;;
  *)
    printf >&2 'usage: merge-check pre-commit | pre-merge-commit | commit-msg <file> | replay <merge>...\n'
    finish 2 ;;
esac
