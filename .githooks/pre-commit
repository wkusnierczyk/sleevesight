#!/usr/bin/env bash
# Before each commit: the branch guard, then ktlint `--format` on the staged Kotlin files.
#
# ktlint runs on the staged content (the index), not the working copy, so what is committed is what
# was formatted; each file it changed is staged again. A file with no unstaged changes gets the
# formatted copy in the working tree as well; a partly staged file keeps its working copy, so unstaged
# work is never touched. The commit fails only on what `--format` cannot fix, after staging the rest.
#
# ktlint is its standalone jar from Maven Central, at the version `gradle/libs.versions.toml` sets for
# the Gradle plugin, downloaded on first use into a cache directory and checked against the SHA-256
# below each time. It takes a second or two, against Gradle's half a minute or more.
# If the download fails (offline, say), the commit goes ahead unformatted, with a warning; the pre-push
# checks and CI still check the formatting.
# `build-logic/` is left out: the Gradle checks do not cover it, and it is not in ktlint's style.
set -euo pipefail
# Paths are file names, never patterns: no globbing of `*?[` and no `:` magic.
export GIT_LITERAL_PATHSPECS=1

"$(dirname "$0")/guard-branch"

# SHA-256 of `ktlint-cli-<version>-all.jar`, by version. A new version: take the `.sha256` beside the
# jar on Maven Central, after checking the jar's `.asc` signature against ktlint's signing key
# (ADBC 987D 1A7B 91DB 6B0A  AA81 995E FBF4 A3D2 0BEB).
ktlint_sha256() {
  case "$1" in
    1.5.0) echo a27854622198800f50971a049dcdba38f2105d47e7e7258786c7d28045c5735d ;;
    *) return 1 ;;
  esac
}

fail() {
  printf >&2 '\npre-commit: %s\n\n' "$*"
  exit 1
}

part=
work=
cleanup() {
  [ -z "$part" ] || rm -f "$part"
  [ -z "$work" ] || rm -rf "$work"
}
trap cleanup EXIT

files=()
while IFS= read -r -d '' path; do
  case "$path" in
    build-logic/*) ;;
    *.kt | *.kts) files+=("$path") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
[ "${#files[@]}" -gt 0 ] || exit 0

version=$(git cat-file blob :gradle/libs.versions.toml | sed -n 's/^ktlint = "\([^"]*\)".*/\1/p')
[ -n "$version" ] || fail 'no ktlint = "<version>" line in gradle/libs.versions.toml.'
sha=$(ktlint_sha256 "$version") ||
  fail "no checksum for ktlint $version in .githooks/pre-commit; add it (see the comment above ktlint_sha256)."

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1
}

cache=${XDG_CACHE_HOME:-$HOME/.cache}/sleevesight/ktlint
jar=$cache/ktlint-cli-$version-all.jar
if [ ! -f "$jar" ] || [ "$(sha256 "$jar")" != "$sha" ]; then
  url=https://repo1.maven.org/maven2/com/pinterest/ktlint/ktlint-cli/$version/ktlint-cli-$version-all.jar
  printf >&2 'pre-commit: downloading ktlint %s (about 70 MB, once) into %s\n' "$version" "$cache"
  mkdir -p "$cache"
  part=$(mktemp "$cache/download.XXXXXX")
  if ! curl -fsSL --retry 2 -o "$part" "$url"; then
    printf >&2 '\npre-commit: WARNING: could not download %s;\n' "$url"
    printf >&2 'the staged Kotlin is committed unformatted. The pre-push checks and CI still check it.\n\n'
    exit 0
  fi
  if [ "$(sha256 "$part")" != "$sha" ]; then
    fail "the download of $url does not match its checksum; it was not used."
  fi
  mv -f "$part" "$jar"
  part=
fi

java=java
if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then java=$JAVA_HOME/bin/java; fi
command -v "$java" >/dev/null 2>&1 || fail 'ktlint needs Java: set JAVA_HOME or put java on the path.'

# The staged files, and the .editorconfig files ktlint reads, copied out of the index into a
# directory of their own with the same layout.
work=$(mktemp -d)
partly=()
for path in "${files[@]}"; do
  mkdir -p "$work/$(dirname "$path")"
  git cat-file blob ":0:$path" >"$work/$path"
  git diff --quiet -- "$path" || partly+=("$path")
done
while IFS= read -r -d '' path; do
  case "$path" in
    .editorconfig | */.editorconfig)
      mkdir -p "$work/$(dirname "$path")"
      git cat-file blob ":0:$path" >"$work/$path" ;;
  esac
done < <(git ls-files -z)

# `git commit <paths>` commits from a temporary index, and git's own index keeps what was staged
# before: those files are formatted in the commit and the working tree, and need a `git add` after.
case "$(basename "${GIT_INDEX_FILE:-index}")" in
  index | index.lock) temporary=false ;;
  *) temporary=true ;;
esac

status=0
(cd "$work" && "$java" -jar "$jar" --format --relative --log-level=error -- "${files[@]}") || status=$?

for path in "${files[@]}"; do
  if git cat-file blob ":0:$path" | cmp -s - "$work/$path"; then continue; fi
  mode=$(git ls-files -s -- "$path" | cut -d' ' -f1)
  blob=$(git hash-object -w --path="$path" "$work/$path")
  git update-index --cacheinfo "$mode,$blob,$path"
  partial=false
  for p in ${partly[@]+"${partly[@]}"}; do [ "$p" = "$path" ] && partial=true; done
  if $partial; then
    printf >&2 'pre-commit: formatted the staged part of %s; its unstaged changes were left as they are.\n' "$path"
  else
    cat "$work/$path" >"$path"
    printf >&2 'pre-commit: formatted %s\n' "$path"
  fi
  if $temporary; then
    printf >&2 'pre-commit: git add %s afterwards: the commit has it formatted, the index has it as staged before.\n' "$path"
  fi
done

[ "$status" -eq 0 ] ||
  fail "ktlint found problems that --format cannot fix (listed above). What it could fix is staged; fix the rest and commit again."
