#!/bin/sh
# Git LFS's hook, as `git lfs install` writes it into `.git/hooks`: with `core.hooksPath` set, git
# reads hooks from this directory instead, so LFS's hooks are here too.
command -v git-lfs >/dev/null 2>&1 || {
  printf >&2 '\nGit LFS is not installed (no git-lfs on the path); this repository keeps its videos in it.\n'
  printf >&2 'Install it, then run: git lfs install --skip-repo\n\n'
  exit 2
}
exec git lfs post-checkout "$@"
