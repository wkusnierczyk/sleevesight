-- The caches (architecture, *Cache and history*). Times are epoch milliseconds. `used_at` is the
-- last read or write, for evicting the least recently used rows under the size limit; `size_bytes`
-- is the UTF-8 size of the row's keys and value, which the limit counts.
--
-- Ids are `AUTOINCREMENT`, so never reused: a cleanup delete by the id (and the timestamp) a read
-- saw cannot remove a row written since. Writes delete the row they replace and insert, never
-- `INSERT OR REPLACE`, whose deletions fire no triggers, so `cache_size` stays exact.

-- What one source lookup gave the pipeline: the `SourceResult`, serialised (`payload`), never the
-- raw response. `format` is the payload's encoding (`RetrievalCodec.FORMAT`), `extraction` the
-- adapter's extraction rules (`SourceAdapter.extractionVersion`); a row with either different is a
-- miss. `sources` holds the tag of the adapter's source, of every source it consults and of every
-- source its lines name, each between spaces (` W WD `): the row expires with the shortest of their
-- lifetimes.
CREATE TABLE retrieval (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    source TEXT NOT NULL,
    lookup_key TEXT NOT NULL,
    sources TEXT NOT NULL,
    format INTEGER NOT NULL,
    extraction INTEGER NOT NULL,
    payload TEXT NOT NULL,
    stored_at INTEGER NOT NULL,
    used_at INTEGER NOT NULL,
    size_bytes INTEGER NOT NULL,
    UNIQUE (source, lookup_key)
);

CREATE INDEX retrieval_used_at ON retrieval (used_at, size_bytes);

-- A credited artist's MusicBrainz id by normalized name: `resolved` with `mbid`, `none`, or
-- `ambiguous` with the candidates' ids in `mbid`, space-separated.
CREATE TABLE artist (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    state TEXT NOT NULL,
    mbid TEXT,
    stored_at INTEGER NOT NULL,
    used_at INTEGER NOT NULL,
    size_bytes INTEGER NOT NULL
);

CREATE INDEX artist_used_at ON artist (used_at, size_bytes);

-- What a source said about one artist, for every track that credits them (#238): `part` names the
-- kind (`lastfm.artist`, `wikipedia.artist`, ...), `artist_key` the artist (a MusicBrainz id, or a
-- folded name where the adapter asks by name), `payload` the adapter's own encoding, never the raw
-- response, under the part's `version`; a row under another version is a miss. `sources` holds the
-- tags of the sources the value depends on, each between spaces, as in `retrieval`: the row expires
-- with the shortest of their lifetimes.
CREATE TABLE artist_result (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    part TEXT NOT NULL,
    artist_key TEXT NOT NULL,
    sources TEXT NOT NULL,
    version INTEGER NOT NULL,
    payload TEXT NOT NULL,
    stored_at INTEGER NOT NULL,
    used_at INTEGER NOT NULL,
    size_bytes INTEGER NOT NULL,
    UNIQUE (part, artist_key)
);

CREATE INDEX artist_result_used_at ON artist_result (used_at, size_bytes);

-- A written insight or card, by the full synthesis key (R2, D14), the reasoning effort included
-- (`low`, `medium`, `high` or `default`).
CREATE TABLE synthesis (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    kind TEXT NOT NULL,
    entity_key TEXT NOT NULL,
    evidence_fingerprint TEXT NOT NULL,
    prompt_version INTEGER NOT NULL,
    style_hash TEXT NOT NULL,
    provider TEXT NOT NULL,
    model TEXT NOT NULL,
    model_knowledge INTEGER NOT NULL,
    effort TEXT NOT NULL,
    text TEXT NOT NULL,
    written_at INTEGER NOT NULL,
    used_at INTEGER NOT NULL,
    size_bytes INTEGER NOT NULL,
    UNIQUE (kind, entity_key, evidence_fingerprint, prompt_version, style_hash, provider, model, model_knowledge, effort)
);

CREATE INDEX synthesis_used_at ON synthesis (used_at, size_bytes);

-- Running totals per table, kept by the triggers below in the transaction of each write, so
-- checking the size limit reads one row per table instead of every row.
CREATE TABLE cache_size (
    name TEXT NOT NULL PRIMARY KEY,
    entries INTEGER NOT NULL,
    bytes INTEGER NOT NULL
);

INSERT INTO cache_size (name, entries, bytes)
VALUES ('retrieval', 0, 0), ('artist', 0, 0), ('synthesis', 0, 0), ('artist_result', 0, 0);

CREATE TRIGGER retrieval_inserted AFTER INSERT ON retrieval BEGIN
    UPDATE cache_size SET entries = entries + 1, bytes = bytes + new.size_bytes WHERE name = 'retrieval';
END;

CREATE TRIGGER retrieval_deleted AFTER DELETE ON retrieval BEGIN
    UPDATE cache_size SET entries = entries - 1, bytes = bytes - old.size_bytes WHERE name = 'retrieval';
END;

CREATE TRIGGER artist_inserted AFTER INSERT ON artist BEGIN
    UPDATE cache_size SET entries = entries + 1, bytes = bytes + new.size_bytes WHERE name = 'artist';
END;

CREATE TRIGGER artist_deleted AFTER DELETE ON artist BEGIN
    UPDATE cache_size SET entries = entries - 1, bytes = bytes - old.size_bytes WHERE name = 'artist';
END;

CREATE TRIGGER artist_result_inserted AFTER INSERT ON artist_result BEGIN
    UPDATE cache_size SET entries = entries + 1, bytes = bytes + new.size_bytes WHERE name = 'artist_result';
END;

CREATE TRIGGER artist_result_deleted AFTER DELETE ON artist_result BEGIN
    UPDATE cache_size SET entries = entries - 1, bytes = bytes - old.size_bytes WHERE name = 'artist_result';
END;

CREATE TRIGGER synthesis_inserted AFTER INSERT ON synthesis BEGIN
    UPDATE cache_size SET entries = entries + 1, bytes = bytes + new.size_bytes WHERE name = 'synthesis';
END;

CREATE TRIGGER synthesis_deleted AFTER DELETE ON synthesis BEGIN
    UPDATE cache_size SET entries = entries - 1, bytes = bytes - old.size_bytes WHERE name = 'synthesis';
END;

-- Retrieval

retrievalGet:
SELECT id, sources, format, extraction, payload, stored_at
FROM retrieval
WHERE source = :source AND lookup_key = :lookupKey;

retrievalRemoveKey:
DELETE FROM retrieval WHERE source = :source AND lookup_key = :lookupKey;

retrievalInsert:
INSERT INTO retrieval (source, lookup_key, sources, format, extraction, payload, stored_at, used_at, size_bytes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

retrievalTouch:
UPDATE retrieval SET used_at = :usedAt WHERE id = :id;

-- The row a read saw, only if it is still that row.
retrievalDeleteSeen:
DELETE FROM retrieval WHERE id = :id AND stored_at = :storedAt;

retrievalDelete:
DELETE FROM retrieval WHERE id = :id;

-- Rows with a line from `tag`'s source stored at or before the cutoff.
retrievalPurgeSource:
DELETE FROM retrieval WHERE instr(sources, ' ' || :tag || ' ') > 0 AND stored_at <= :storedAtOrBefore;

-- Each row's sources, for purging the rows that hold a source the app no longer has.
retrievalSources:
SELECT id, stored_at, sources FROM retrieval;

retrievalPurgeFormat:
DELETE FROM retrieval WHERE format <> :format;

-- The results that say something about an artist, when keeping that is switched off (#420): those
-- whose payload holds one of the markers `RetrievalCodec` names.
retrievalDeleteAboutArtists:
DELETE FROM retrieval
WHERE instr(payload, :scopeMarker) > 0
   OR instr(payload, :genresMarker) > 0
   OR instr(payload, :labelArtistsMarker) > 0
   OR instr(payload, :artistArticleMarker) > 0;

-- Artist resolution

artistGet:
SELECT id, state, mbid, stored_at
FROM artist
WHERE name = :name;

artistRemoveKey:
DELETE FROM artist WHERE name = :name;

artistInsert:
INSERT INTO artist (name, state, mbid, stored_at, used_at, size_bytes)
VALUES (?, ?, ?, ?, ?, ?);

artistTouch:
UPDATE artist SET used_at = :usedAt WHERE id = :id;

artistDeleteSeen:
DELETE FROM artist WHERE id = :id AND stored_at = :storedAt;

artistDelete:
DELETE FROM artist WHERE id = :id;

artistPurge:
DELETE FROM artist WHERE stored_at <= :storedAtOrBefore;

-- Every artist resolution, when keeping what is said about artists is switched off (#420).
artistDeleteAll:
DELETE FROM artist;

-- Artist-level results

artistResultGet:
SELECT id, sources, version, payload, stored_at
FROM artist_result
WHERE part = :part AND artist_key = :artistKey;

artistResultRemoveKey:
DELETE FROM artist_result WHERE part = :part AND artist_key = :artistKey;

artistResultInsert:
INSERT INTO artist_result (part, artist_key, sources, version, payload, stored_at, used_at, size_bytes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

artistResultTouch:
UPDATE artist_result SET used_at = :usedAt WHERE id = :id;

artistResultDeleteSeen:
DELETE FROM artist_result WHERE id = :id AND stored_at = :storedAt;

artistResultDelete:
DELETE FROM artist_result WHERE id = :id;

-- Rows depending on `tag`'s source stored at or before the cutoff.
artistResultPurgeSource:
DELETE FROM artist_result WHERE instr(sources, ' ' || :tag || ' ') > 0 AND stored_at <= :storedAtOrBefore;

-- Each row's sources, for purging the rows that hold a source the app no longer has.
artistResultSources:
SELECT id, stored_at, sources FROM artist_result;

-- Every artist-level result, when keeping what is said about artists is switched off (#420).
artistResultDeleteAll:
DELETE FROM artist_result;

-- Synthesis

synthesisGet:
SELECT id, text, written_at
FROM synthesis
WHERE kind = :kind
  AND entity_key = :entityKey
  AND evidence_fingerprint = :evidenceFingerprint
  AND prompt_version = :promptVersion
  AND style_hash = :styleHash
  AND provider = :provider
  AND model = :model
  AND model_knowledge = :modelKnowledge
  AND effort = :effort;

synthesisRemoveKey:
DELETE FROM synthesis
WHERE kind = :kind
  AND entity_key = :entityKey
  AND evidence_fingerprint = :evidenceFingerprint
  AND prompt_version = :promptVersion
  AND style_hash = :styleHash
  AND provider = :provider
  AND model = :model
  AND model_knowledge = :modelKnowledge
  AND effort = :effort;

synthesisInsert:
INSERT INTO synthesis (
    kind, entity_key, evidence_fingerprint, prompt_version, style_hash, provider, model, model_knowledge, effort,
    text, written_at, used_at, size_bytes
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

synthesisTouch:
UPDATE synthesis SET used_at = :usedAt WHERE id = :id;

synthesisDelete:
DELETE FROM synthesis WHERE id = :id;

-- Size and eviction

tableSizes:
SELECT name, entries, bytes FROM cache_size;

-- The same, counted from the rows: for the tests, which check the running totals against it.
tableSizesCounted:
SELECT 'retrieval' AS name, count(*) AS entries, coalesce(sum(size_bytes), 0) AS bytes FROM retrieval
UNION ALL
SELECT 'artist', count(*), coalesce(sum(size_bytes), 0) FROM artist
UNION ALL
SELECT 'artist_result', count(*), coalesce(sum(size_bytes), 0) FROM artist_result
UNION ALL
SELECT 'synthesis', count(*), coalesce(sum(size_bytes), 0) FROM synthesis;

-- Retrieval, artist-level and synthesis rows, least recently used first; artist resolution rows are
-- evicted only after them.
leastRecentlyUsed:
SELECT 'retrieval' AS name, id, size_bytes, used_at FROM retrieval
UNION ALL
SELECT 'artist_result', id, size_bytes, used_at FROM artist_result
UNION ALL
SELECT 'synthesis', id, size_bytes, used_at FROM synthesis
ORDER BY used_at, name, id
LIMIT :limit;

leastRecentlyUsedArtists:
SELECT id, size_bytes FROM artist
ORDER BY used_at, id
LIMIT :limit;
