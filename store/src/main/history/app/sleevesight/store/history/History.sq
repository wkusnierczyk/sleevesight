-- The session history and the record of track changes (architecture, *Cache and history* and
-- *Learning skip detection*, D15): on the phone only, outside the caches' size limit, and cleared
-- together (`clear`). Times are epoch milliseconds, lengths and offsets milliseconds. Ids are
-- `AUTOINCREMENT`, so rows keep the order they were written in, and an id is never reused, even
-- after `clear`.

-- Each track the session layer saw play, once (a track repeated right away is the same track): the
-- default track list, "Played this session". `session` numbers the listening sessions, from 1: a
-- track that starts more than the session gap after the previous one should have ended
-- (`played_at` plus `duration_ms`) begins the next. The artists are the player's string, as sent.
-- `queue_item` is the active queue item, kept so the track is known again after a restart.
CREATE TABLE played (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    session INTEGER NOT NULL,
    played_at INTEGER NOT NULL,
    player TEXT NOT NULL,
    title TEXT NOT NULL,
    artists TEXT NOT NULL,
    album TEXT,
    duration_ms INTEGER,
    media_id TEXT,
    queue_item INTEGER
);

CREATE INDEX played_session ON played (session, id);

-- Each change from one track to another, with the features skip detection learns from (D15):
-- when it began (`changed_at`), the player, the time the previous track had left, the time since
-- the user's last action in Sleevesight, and the crossfade learned by then. A feature that could
-- not be measured, or has no source yet, is null.
CREATE TABLE track_change (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    player TEXT NOT NULL,
    changed_at INTEGER NOT NULL,
    time_left_ms INTEGER,
    since_action_ms INTEGER,
    learned_crossfade_ms INTEGER
);

CREATE INDEX track_change_player ON track_change (player, changed_at);

-- The playback states the player reported before a change, in the order they came (`seq`, from
-- 0): the pattern of states, as Spotify's clusters before a natural end. `received_before_ms` is
-- how long before the change each came; `position_ms` the position it reported, taken
-- `position_before_ms` before the change (negative if after it); `status` the session layer's
-- name for its state (`PLAYING`, `PAUSED`, ...).
CREATE TABLE track_change_state (
    change_id INTEGER NOT NULL REFERENCES track_change (id),
    seq INTEGER NOT NULL,
    received_before_ms INTEGER NOT NULL,
    status TEXT NOT NULL,
    position_ms INTEGER,
    position_before_ms INTEGER NOT NULL,
    speed REAL NOT NULL,
    PRIMARY KEY (change_id, seq)
);

-- Played

lastPlayed:
SELECT * FROM played ORDER BY id DESC LIMIT 1;

playedInsert:
INSERT INTO played (session, played_at, player, title, artists, album, duration_ms, media_id, queue_item)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- The same track, as the player filled it in later (artists sent after the title, a new length).
playedUpdate:
UPDATE played
SET title = :title, artists = :artists, album = :album, duration_ms = :duration_ms, media_id = :media_id, queue_item = :queue_item
WHERE id = :id;

playedInSession:
SELECT * FROM played WHERE session = :session ORDER BY id;

-- Track changes

trackChangeInsert:
INSERT INTO track_change (player, changed_at, time_left_ms, since_action_ms, learned_crossfade_ms)
VALUES (?, ?, ?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

stateInsert:
INSERT INTO track_change_state (change_id, seq, received_before_ms, status, position_ms, position_before_ms, speed)
VALUES (?, ?, ?, ?, ?, ?, ?);

trackChanges:
SELECT * FROM track_change ORDER BY id;

states:
SELECT * FROM track_change_state ORDER BY change_id, seq;

-- Both, in one transaction.
clear {
    DELETE FROM track_change_state;
    DELETE FROM track_change;
    DELETE FROM played;
}
