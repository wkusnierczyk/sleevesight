     ],
     "status": "ok"
    },
    {
     "s": "It is sung to the traditional Irish jig tune Larry O'Gaff, and its melody matches the Flanagan Brothers' 1927 recording Mick from Tralee [W2][G3].",
     "cites": [
      "W2",
      "G3"
     ],
     "status": "ok"
    },
    {
     "s": "The song is about squid jigging, where bait squid are caught with a baitless metal jigger of tiny hooks, on inshore grounds usually from July into August [G6][G8].",
     "cites": [
      "G6",
      "G8"
     ],
     "status": "ok"
    },
    {
     "s": "Dick Nolan is a Newfoundland folk performer known for Toronto nightclub work [L1][L2], but the sources I have don't mention his recording of this song, so its details are not documented here [W6][G5].",
     "cites": [
      "L1",
      "L2",
      "W6",
      "G5"
     ],
     "status": "ok"
    }
   ]
